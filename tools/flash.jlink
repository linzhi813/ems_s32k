// J-Link Commander script for flashing EMS S32K firmware
//
// Usage:
//   JLinkExe -device S32K344 -if SWD -speed 4000 -CommanderScript tools/flash.jlink
//
// Or from CMake:
//   cmake --build build --target flash

// ── 脚本内路径相对于项目根目录（由 CMake 的 WORKING_DIRECTORY 保证，
//    手动运行也从项目根目录执行）──
device S32K344
si SWD
speed 4000

// Connect to target
connect

// Halt the CPU
halt

// Erase flash sectors occupied by application (first 1MB of P-Flash)
erase 0x00400000 0x004FFFFF

// Program firmware
loadbin build/ems_s32k.bin 0x00400000

// Verify
verifybin build/ems_s32k.bin 0x00400000

// Reset and run
r
g

qc
